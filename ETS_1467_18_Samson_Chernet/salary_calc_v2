#include <iostream>
using namespace std;
int main()
{

    // choose worker type
    int worker_type;
    cout << "enter worker type (1 = employee, 2 = laborer): ";
    cin >> worker_type;

    // EMPLOYEE
    if (worker_type == 1)
    {
        // declaration of inputs
        int base_salary, worked_hours, bonus_rate;

        // declaration of outputs
        float pension, gross_salary, tax, net_salary;
        float base_rate;
        int bonus_salary;
        int extra_hours = 0;

        // input stage
        cout << "enter the base salary: ";
        cin >> base_salary;
        cout << "enter weekly worked hours (>= 40hrs/week): ";
        cin >> worked_hours;
        cout << "enter bonus rate (..ETB/hrs): ";
        cin >> bonus_rate;

        // rate per hour (calculated AFTER the input)
        base_rate = base_salary / 40.0;

      
        if (worked_hours > 40)
        {
            extra_hours = worked_hours - 40;
        }
        else if (worked_hours < 40)
        {
            
            base_salary = base_salary - base_rate * (40 - worked_hours);
        }

        
        bonus_salary = bonus_rate * extra_hours;

        
        gross_salary = base_salary + bonus_salary;

        // pension deduction 7% of gros
        pension = gross_salary * (0.07);

        if (gross_salary <= 3500)
        {
            tax = 0;
        }
        else if (gross_salary > 3500 && gross_salary <= 10000)
        {
            tax = gross_salary * 0.1;
        }
        else if (gross_salary > 10000 && gross_salary <= 25000)
        {
            tax = gross_salary * 0.15;
        }
        else if (gross_salary > 25000 && gross_salary <= 50000)
        {
            tax = gross_salary * 0.2;
        }
        else if (gross_salary > 50000 && gross_salary <= 100000)
        {
            tax = gross_salary * 0.25;
        }
        else
        {
            tax = gross_salary * (0.3);
        }

        // net salary calculation
        net_salary = gross_salary - pension - tax;

        // printing the outputs
        int display;

        cout << "display all? press 1: " << endl;
        cout << "display bonus payment? press 2: " << endl;
        cout << "display deducted pension? press 3: " << endl;
        cout << "display net salary? press 4: " << endl;
        cout << "display gross salary? press 5: " << endl;
        cout << "display deducted tax? press 6: " << endl;
        cin >> display;

        switch (display)
        {
        case 1:
            cout << "\nthe gross salary is: birr " << gross_salary << endl;
            cout << "the bonus payment is: birr " << bonus_salary << endl;
            cout << "the deducted tax is: birr " << tax << endl;
            cout << "the deducted pension is: birr " << pension << endl;
            cout << "the net salary is: birr " << net_salary << endl;
            break;
        case 2:
            cout << "the bonus payment is: birr " << bonus_salary << endl;
            break;
        case 3:
            cout << "the deducted pension is: birr " << pension << endl;
            break;
        case 4:
            cout << "the net salary is: birr " << net_salary << endl;
            break;
        case 5:
            cout << "\nthe gross salary is: birr " << gross_salary << endl;
            break;
        case 6:
            cout << "\ndeducted tax: birr " << tax << endl;
            break;
        default:
            cout << "invalid input" << endl;
        }
    }

    //  LABORER 
    else if (worker_type == 2)
    {
        // declaration of inputs
        float worked_hours, hourly_rate, bonus, damage_penalty;
        int has_bonus, has_damage;

        // declaration of outputs
        float gross_salary, net_salary;

        bonus = 0;
        damage_penalty = 0;

        // input stage
        cout << "enter worked hours: ";
        cin >> worked_hours;
        cout << "enter hourly rate (..ETB/hr): ";
        cin >> hourly_rate;

        cout << "does the laborer have a bonus? (1 = yes, 0 = no): ";
        cin >> has_bonus;
        if (has_bonus == 1)
        {
            cout << "enter the bonus amount: ";
            cin >> bonus;
        }

        cout << "did the laborer damage any machinery? (1 = yes, 0 = no): ";
        cin >> has_damage;
        if (has_damage == 1)
        {
            cout << "enter the penalty amount: ";
            cin >> damage_penalty;
        }

        
        gross_salary = (worked_hours * hourly_rate) + bonus;

        net_salary = gross_salary - damage_penalty;

        if (net_salary < 0)
        {
            net_salary = 0;
        }

        int display;

        cout << "display all? press 1: " << endl;
        cout << "display bonus payment? press 2: " << endl;
        cout << "display damage penalty? press 3: " << endl;
        cout << "display net salary? press 4: " << endl;
        cout << "display gross salary? press 5: " << endl;
        cin >> display;

        switch (display)
        {
        case 1:
            cout << "\nthe worked hours are: " << worked_hours << endl;
            cout << "the hourly rate is: birr " << hourly_rate << endl;
            cout << "the gross salary is: birr " << gross_salary << endl;
            cout << "the bonus payment is: birr " << bonus << endl;
            cout << "the damage penalty is: birr " << damage_penalty << endl;
            cout << "the net salary is: birr " << net_salary << endl;
            break;
        case 2:
            cout << "the bonus payment is: birr " << bonus << endl;
            break;
        case 3:
            cout << "the damage penalty is: birr " << damage_penalty << endl;
            break;
        case 4:
            cout << "the net salary is: birr " << net_salary << endl;
            break;
        case 5:
            cout << "\nthe gross salary is: birr " << gross_salary << endl;
            break;
        default:
            cout << "invalid input" << endl;
        }
    }

    else
    {
        cout << "invalid worker type" << endl;
    }

    return 0;
}
